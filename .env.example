WEBHOOK_SECRET=change-me-to-random-string

MINI_APP_PATH=/app
PORT=3000
NODE_ENV=production

# Ваш Telegram ID — сюда приходят заявки на консультацию (узнать: @userinfobot)
ADMIN_CHAT_ID=123456789
