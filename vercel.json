{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/telegram", "destination": "/api/telegram" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "public/**"
    },
    "api/telegram.ts": {
      "includeFiles": "src/**"
    }
  }
}
