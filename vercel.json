{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    {
      "source": "/((?!api/telegram|api/health|app/.*).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/index.ts": {
      "includeFiles": "public/**",
      "maxDuration": 30
    },
    "api/telegram.ts": {
      "includeFiles": "src/**",
      "maxDuration": 30
    }
  }
}
